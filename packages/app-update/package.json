{
  "name": "@expo-kit/app-update",
  "version": "58.2.0",
  "description": "App Store and EAS Update checks with a native update sheet for Expo apps",
  "keywords": [
    "expo",
    "expo-kit",
    "react-native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamashraful/expo-kit.git",
    "directory": "packages/app-update"
  },
  "homepage": "https://github.com/islamashraful/expo-kit/tree/main/packages/app-update#readme",
  "bugs": {
    "url": "https://github.com/islamashraful/expo-kit/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-kit/core": "workspace:^"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo-application": "^58.0.0",
    "expo-sqlite": "^58.0.0",
    "expo-updates": "^58.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@expo/ui": "~58.0.23",
    "@types/react": "~19.3.0",
    "expo-application": "~58.1.2",
    "expo-sqlite": "~58.0.14",
    "expo-updates": "~58.0.18",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
