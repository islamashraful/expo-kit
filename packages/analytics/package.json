{
  "name": "@expo-kit/analytics",
  "version": "58.1.0",
  "description": "PostHog analytics setup for Expo apps",
  "keywords": [
    "expo",
    "expo-kit",
    "react-native",
    "posthog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamashraful/expo-kit.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://github.com/islamashraful/expo-kit/tree/main/packages/analytics#readme",
  "bugs": {
    "url": "https://github.com/islamashraful/expo-kit/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
