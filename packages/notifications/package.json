{
  "name": "@islamashraful/notifications",
  "version": "0.0.1",
  "description": "Notification permission, tap handling and scheduling helpers for Expo apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamashraful/expo-kit.git",
    "directory": "packages/notifications"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@islamashraful/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "expo-notifications": ">=57.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-notifications": "~57.0.22",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
