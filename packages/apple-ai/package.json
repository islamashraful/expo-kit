{
  "name": "@expo-kit/apple-ai",
  "version": "58.0.0",
  "private": true,
  "description": "Apple's on-device language model (Foundation Models) for Expo apps",
  "keywords": [
    "expo",
    "expo-kit",
    "react-native",
    "apple-intelligence",
    "foundation-models",
    "llm",
    "on-device"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamashraful/expo-kit.git",
    "directory": "packages/apple-ai"
  },
  "homepage": "https://github.com/islamashraful/expo-kit/tree/main/packages/apple-ai#readme",
  "bugs": {
    "url": "https://github.com/islamashraful/expo-kit/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "ios",
    "expo-module.config.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@expo-kit/core": "workspace:^"
  },
  "peerDependencies": {
    "expo": "^58.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.19",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
