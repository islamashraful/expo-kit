{
  "name": "@expo-kit/core",
  "version": "58.0.0",
  "description": "Shared hooks for Expo apps",
  "keywords": [
    "expo",
    "expo-kit",
    "react-native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamashraful/expo-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/islamashraful/expo-kit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/islamashraful/expo-kit/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./storage": {
      "types": "./build/storage.d.ts",
      "react-native": "./src/storage.ts",
      "default": "./build/storage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo-sqlite": "^58.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-sqlite": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
