{
  "name": "@islamashraful/core",
  "version": "0.0.1",
  "description": "Shared hooks for Expo apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamashraful/expo-kit.git",
    "directory": "packages/core"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
